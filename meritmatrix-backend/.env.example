# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.

# --- Core application ---
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- Database ---
# Used directly by docker-compose to initialize the Postgres container.
POSTGRES_USER=meritmatrix
POSTGRES_PASSWORD=change_me_dev_only
POSTGRES_DB=meritmatrix

# Used by the backend app. When running via docker-compose the host is "db";
# when running the backend locally against a host Postgres, use "localhost".
DATABASE_URL=postgresql+psycopg://meritmatrix:change_me_dev_only@localhost:5432/meritmatrix

# --- Security / Auth ---
# Generate strong random values for these, e.g.: openssl rand -hex 32
SECRET_KEY=
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- Frontend ---
FRONTEND_URL=http://localhost:5173

# --- Email (SMTP) — provider-agnostic ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@meritmatrix.local

# --- SMS / OTP provider ---
# "mock" is safe for local development; never use it in production.
SMS_PROVIDER=mock
OTP_MOCK_STATIC_CODE=
